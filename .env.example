# Supabase > Project Settings > API
# Utilisez uniquement l'URL du projet et la clé "anon" (ou "publishable").
# N'utilisez JAMAIS la clé "service_role" dans ce projet.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-ou-publishable

# Cloudflare Turnstile (anti-spam du formulaire de contact) : clé PUBLIQUE du widget.
# Sans elle, le formulaire insère directement dans Supabase (à réserver au développement).
# La clé secrète vit dans les secrets de la fonction Edge (TURNSTILE_SECRET_KEY), jamais ici.
VITE_TURNSTILE_SITE_KEY=

# URL publique du site (https://votre-domaine.tld) : sert aux balises og:image et canonical.
# Sans elle, ces balises ne sont pas émises.
VITE_SITE_URL=
